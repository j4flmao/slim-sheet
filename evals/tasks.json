{
  "version": 1,
  "files": ["sales.xlsx", "messy.xlsx", "people.csv", "macros.xlsm"],
  "tasks": [
    {"id": "orders-count", "prompt": "How many orders are in the Orders sheet of sales.xlsx?",
     "tools": ["overview", "query", "profile"], "check": {"kind": "number", "value": 300},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT count(*) FROM \"Orders\""}}]},
    {"id": "revenue-total", "prompt": "What is the total revenue (sum of the Total column) in the Orders sheet of sales.xlsx?",
     "tools": ["query"], "check": {"kind": "number", "value": 14962.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Total\") FROM \"Orders\""}}]},
    {"id": "revenue-north", "prompt": "In sales.xlsx, what is the total revenue for the North region in Q1 2026?",
     "tools": ["query"], "check": {"kind": "number", "value": 7462.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Total\") FROM \"Orders\" WHERE \"Region\" = 'North'"}}]},
    {"id": "top-region", "prompt": "Which region has the higher total revenue in sales.xlsx, North or South?",
     "tools": ["query"], "check": {"kind": "text", "value": "South"},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"Region\", sum(\"Total\") FROM \"Orders\" GROUP BY 1 ORDER BY 2 DESC LIMIT 1"}}]},
    {"id": "qty-south", "prompt": "How many units (sum of Qty) were sold in the South region according to sales.xlsx?",
     "tools": ["query"], "check": {"kind": "number", "value": 600},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Qty\") FROM \"Orders\" WHERE \"Region\" = 'South'"}}]},
    {"id": "avg-order", "prompt": "What is the average order Total in the Orders sheet of sales.xlsx?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 49.875, "tolerance": 0.01},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT avg(\"Total\") FROM \"Orders\""}}]},
    {"id": "max-order", "prompt": "What is the largest single order Total in sales.xlsx?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 87.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT max(\"Total\") FROM \"Orders\""}}]},
    {"id": "revenue-january", "prompt": "What was the total revenue in January 2026 in the Orders sheet of sales.xlsx?",
     "tools": ["query"], "check": {"kind": "number", "value": 6112.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Total\") FROM \"Orders\" WHERE month(\"Date\") = 1"}}]},
    {"id": "revenue-march-south", "prompt": "What was the South region's revenue in March 2026 in sales.xlsx?",
     "tools": ["query"], "check": {"kind": "number", "value": 2400},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Total\") FROM \"Orders\" WHERE month(\"Date\") = 3 AND \"Region\" = 'South'"}}]},
    {"id": "qty-seven-count", "prompt": "How many orders in sales.xlsx have a Qty of exactly 7?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 42},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT count(*) FROM \"Orders\" WHERE \"Qty\" = 7"}}]},
    {"id": "orders-over-50", "prompt": "How many orders in sales.xlsx have a Total greater than 50?",
     "tools": ["query"], "check": {"kind": "number", "value": 128},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT count(*) FROM \"Orders\" WHERE \"Total\" > 50"}}]},
    {"id": "order-date", "prompt": "On what date was order 10123 placed? The data is in sales.xlsx. Give the date as YYYY-MM-DD.",
     "tools": ["query", "find"], "check": {"kind": "text", "value": "2026-02-03"},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"Date\" FROM \"Orders\" WHERE \"OrderID\" = 10123"}}]},
    {"id": "order-total", "prompt": "What is the Total of order 10042 in sales.xlsx?",
     "tools": ["query", "find"], "check": {"kind": "number", "value": 12.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"Total\" FROM \"Orders\" WHERE \"OrderID\" = 10042"}}]},
    {"id": "distinct-dates", "prompt": "How many distinct order dates are there in the Orders sheet of sales.xlsx?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 90},
     "reference": [{"tool": "profile", "args": {"path": "sales.xlsx", "sheet": "Orders", "columns": ["Date"]}}]},
    {"id": "median-qty", "prompt": "What is the median Qty per order in sales.xlsx?",
     "tools": ["profile", "query"], "check": {"kind": "number", "value": 4},
     "reference": [{"tool": "profile", "args": {"path": "sales.xlsx", "sheet": "Orders", "columns": ["Qty"]}}]},
    {"id": "sheet-count", "prompt": "How many sheets does sales.xlsx contain (including hidden ones)?",
     "tools": ["overview"], "check": {"kind": "number", "value": 5},
     "reference": [{"tool": "overview", "args": {"path": "sales.xlsx"}}]},
    {"id": "hidden-sheet", "prompt": "Which sheet in sales.xlsx is hidden?",
     "tools": ["overview"], "check": {"kind": "text", "value": "Secret"},
     "reference": [{"tool": "overview", "args": {"path": "sales.xlsx"}}]},
    {"id": "duplicate-invoices", "prompt": "Find the duplicate invoice numbers in the Invoices sheet of sales.xlsx.",
     "tools": ["query"], "check": {"kind": "all", "values": ["INV-1003", "INV-1011"]},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"InvoiceNo\", count(*) FROM \"Invoices\" GROUP BY 1 HAVING count(*) > 1"}}]},
    {"id": "invoice-acme", "prompt": "What is the total invoiced Amount for customer Acme in sales.xlsx?",
     "tools": ["query"], "check": {"kind": "number", "value": 1900},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Amount\") FROM \"Invoices\" WHERE \"Customer\" = 'Acme'"}}]},
    {"id": "invoice-top-customer", "prompt": "Which customer has the highest total invoice Amount in sales.xlsx?",
     "tools": ["query"], "check": {"kind": "text", "value": "Umbrella"},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"Customer\", sum(\"Amount\") FROM \"Invoices\" GROUP BY 1 ORDER BY 2 DESC LIMIT 1"}}]},
    {"id": "invoice-cell", "prompt": "Which cell of the Invoices sheet in sales.xlsx holds invoice INV-1020? Answer with the cell address.",
     "tools": ["find"], "check": {"kind": "cells", "values": ["Invoices!A22"]},
     "reference": [{"tool": "find", "args": {"path": "sales.xlsx", "text": "INV-1020"}}]},
    {"id": "invoice-1011-cells", "prompt": "List every cell address in sales.xlsx that contains INV-1011.",
     "tools": ["find"], "check": {"kind": "cells", "values": ["Invoices!A13", "Invoices!A21", "Invoices!A33"]},
     "reference": [{"tool": "find", "args": {"path": "sales.xlsx", "text": "INV-1011"}}]},
    {"id": "target-south", "prompt": "What is the South region's target in the 'Q1 Targets' sheet of sales.xlsx?",
     "tools": ["read", "query"], "check": {"kind": "number", "value": 4500},
     "reference": [{"tool": "read", "args": {"path": "sales.xlsx", "sheet": "Q1 Targets"}}]},
    {"id": "target-gap-north", "prompt": "In sales.xlsx, by how much did the North region's total revenue (Orders sheet) exceed its target in the 'Q1 Targets' sheet?",
     "tools": ["query", "read"], "check": {"kind": "number", "value": 2462.5},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT (SELECT sum(\"Total\") FROM \"Orders\" WHERE \"Region\" = 'North') - (SELECT \"Target\" FROM \"Q1 Targets\" WHERE \"Region\" = 'North')"}}]},
    {"id": "refund-cells", "prompt": "Which cells in sales.xlsx mention a refund? Answer with the cell addresses.",
     "tools": ["find"], "check": {"kind": "cells", "values": ["Notes!B3", "Notes!B6"]},
     "reference": [{"tool": "find", "args": {"path": "sales.xlsx", "text": "refund"}}]},
    {"id": "refund-order", "prompt": "One of the notes in sales.xlsx mentions a refund for an order. Which order number?",
     "tools": ["find", "read"], "check": {"kind": "number", "value": 10042},
     "reference": [{"tool": "find", "args": {"path": "sales.xlsx", "text": "refund"}}]},
    {"id": "notes-d1", "prompt": "What text is in cell D1 of the Notes sheet in sales.xlsx?",
     "tools": ["read"], "check": {"kind": "text", "value": "merged"},
     "reference": [{"tool": "read", "args": {"path": "sales.xlsx", "sheet": "Notes", "range": "D1"}}]},
    {"id": "messy-refund-cell", "prompt": "Which cell in messy.xlsx contains the word 'refund'? Answer with the cell address.",
     "tools": ["find"], "check": {"kind": "cells", "values": ["Report!F4"]},
     "reference": [{"tool": "find", "args": {"path": "messy.xlsx", "text": "refund"}}]},
    {"id": "report-qty-sum", "prompt": "In the item table of the Report sheet in messy.xlsx, what is the total Qty across all items?",
     "tools": ["query", "read"], "check": {"kind": "number", "value": 14},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT sum(\"Qty\") FROM \"Report\""}}]},
    {"id": "report-ink-price", "prompt": "What is the Price of ink in messy.xlsx?",
     "tools": ["read", "query", "find"], "check": {"kind": "number", "value": 7},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT \"Price\" FROM \"Report\" WHERE \"Item\" = 'ink'"}}]},
    {"id": "report-stock-value", "prompt": "In messy.xlsx, what is the total stock value of the items in the Report sheet (sum of Qty times Price)?",
     "tools": ["query", "read"], "check": {"kind": "number", "value": 76.75},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT sum(\"Qty\" * \"Price\") FROM \"Report\""}}]},
    {"id": "report-top-item", "prompt": "Which item in messy.xlsx has the highest Qty?",
     "tools": ["query", "read"], "check": {"kind": "text", "value": "ink"},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT \"Item\" FROM \"Report\" ORDER BY \"Qty\" DESC LIMIT 1"}}]},
    {"id": "report-code-note", "prompt": "In the second table of the Report sheet in messy.xlsx, what is the Note for code A?",
     "tools": ["query", "read"], "check": {"kind": "text", "value": "refund issued"},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT \"Note\" FROM \"Report.2\" WHERE \"Code\" = 'A'"}}]},
    {"id": "calc-b1-formula", "prompt": "Which function does the formula in cell B1 of the Calc sheet in messy.xlsx use, and over which range?",
     "tools": ["explain_formula"], "check": {"kind": "all", "values": ["SUM", "A1:A2"]},
     "reference": [{"tool": "explain_formula", "args": {"path": "messy.xlsx", "cell": "Calc!B1"}}]},
    {"id": "calc-c7-broken", "prompt": "The formula in Calc!C7 of messy.xlsx is broken. What is wrong with it?",
     "tools": ["explain_formula"], "check": {"kind": "any", "values": ["missing ')'", "missing )", "closing paren", "parenthes", "unbalanced", "unclosed", "not closed", "missing a closing", "missing closing"]},
     "reference": [{"tool": "explain_formula", "args": {"path": "messy.xlsx", "cell": "Calc!C7"}}]},
    {"id": "calc-c5-typo", "prompt": "Check the formula in Calc!C5 of messy.xlsx. Which function name is wrong, and what should it be?",
     "tools": ["explain_formula"], "check": {"kind": "all", "values": ["SUMM", "SUM"]},
     "reference": [{"tool": "explain_formula", "args": {"path": "messy.xlsx", "cell": "Calc!C5"}}]},
    {"id": "vlookup-arity", "prompt": "Is the formula =VLOOKUP(A1,B1:C9) valid? What is the minimum number of arguments VLOOKUP needs?",
     "tools": ["explain_formula"], "check": {"kind": "number", "value": 3},
     "reference": [{"tool": "explain_formula", "args": {"formula": "=VLOOKUP(A1,B1:C9)"}}]},
    {"id": "people-avg-age", "prompt": "What is the average age in people.csv?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 36.5},
     "reference": [{"tool": "query", "args": {"path": "people.csv", "sql": "SELECT avg(age) FROM data"}}]},
    {"id": "people-city3", "prompt": "How many people in people.csv live in City 3?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 10},
     "reference": [{"tool": "query", "args": {"path": "people.csv", "sql": "SELECT count(*) FROM data WHERE city = 'City 3'"}}]},
    {"id": "people-max-age", "prompt": "What is the age of the oldest person in people.csv?",
     "tools": ["query", "profile"], "check": {"kind": "number", "value": 59},
     "reference": [{"tool": "query", "args": {"path": "people.csv", "sql": "SELECT max(age) FROM data"}}]},
    {"id": "people-youngest", "prompt": "Who are the youngest people in people.csv? Give their names.",
     "tools": ["query"], "check": {"kind": "all", "values": ["user0", "user40"]},
     "reference": [{"tool": "query", "args": {"path": "people.csv", "sql": "SELECT name FROM data WHERE age = (SELECT min(age) FROM data)"}}]},
    {"id": "write-grand-total", "prompt": "In sales.xlsx, write the label 'Grand Total' into Orders!G1 and the total revenue (sum of Total) into Orders!H1.",
     "tools": ["query", "write"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Orders!G1": "Grand Total", "Orders!H1": 14962.5}},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT sum(\"Total\") FROM \"Orders\""}},
                   {"tool": "write", "args": {"path": "sales.xlsx", "sheet": "Orders", "range": "G1:H1", "values": [["Grand Total", 14962.5]]}}]},
    {"id": "write-summary-sheet", "prompt": "In sales.xlsx, create a sheet named Summary with headers Region and Revenue in A1:B1, then one row per region below (North in row 2, South in row 3) with its total revenue from the Orders sheet.",
     "tools": ["query", "write"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Summary!A1": "Region", "Summary!B1": "Revenue", "Summary!A2": "North", "Summary!B2": 7462.5, "Summary!A3": "South", "Summary!B3": 7500}},
     "reference": [{"tool": "query", "args": {"path": "sales.xlsx", "sql": "SELECT \"Region\", sum(\"Total\") FROM \"Orders\" GROUP BY 1 ORDER BY 1"}},
                   {"tool": "write", "args": {"path": "sales.xlsx", "sheet": "Summary", "range": "A1:B3", "values": [["Region", "Revenue"], ["North", 7462.5], ["South", 7500]]}}]},
    {"id": "write-actuals", "prompt": "In the 'Q1 Targets' sheet of sales.xlsx, add a header 'Actual' in C1 and put each region's actual total revenue (from the Orders sheet) next to its target in column C.",
     "tools": ["query", "read", "write"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Q1 Targets!C1": "Actual", "Q1 Targets!C2": 7462.5, "Q1 Targets!C3": 7500}},
     "reference": [{"tool": "read", "args": {"path": "sales.xlsx", "sheet": "Q1 Targets"}},
                   {"tool": "write", "args": {"path": "sales.xlsx", "sheet": "Q1 Targets", "range": "C1:C3", "values": [["Actual"], [7462.5], [7500]]}}]},
    {"id": "write-stock-value", "prompt": "In messy.xlsx, put the label 'Value' in Report!B8 and the total stock value of the items (sum of Qty times Price) in Report!C8.",
     "tools": ["query", "write"], "check": {"kind": "written", "file": "messy.slim.xlsx", "cells": {"Report!B8": "Value", "Report!C8": 76.75}},
     "reference": [{"tool": "query", "args": {"path": "messy.xlsx", "sql": "SELECT sum(\"Qty\" * \"Price\") FROM \"Report\""}},
                   {"tool": "write", "args": {"path": "messy.xlsx", "sheet": "Report", "range": "B8:C8", "values": [["Value", 76.75]]}}]},
    {"id": "sort-targets", "prompt": "In sales.xlsx, sort the 'Q1 Targets' sheet by Target from smallest to largest (keep the header on top).",
     "tools": ["range_ops", "read"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Q1 Targets!A2": "South", "Q1 Targets!B2": 4500, "Q1 Targets!A3": "North"}},
     "reference": [{"tool": "range_ops", "args": {"path": "sales.xlsx", "sheet": "Q1 Targets", "op": "sort", "range": "A1:B3", "by": "Target"}}]},
    {"id": "fill-double-target", "prompt": "In the 'Q1 Targets' sheet of sales.xlsx, write the header 'Double' in C1 and the formula =B2*2 in C2, then fill that formula down to C3.",
     "tools": ["write", "range_ops"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Q1 Targets!C1": "Double", "Q1 Targets!C2": "=B2*2", "Q1 Targets!C3": "=B3*2"}},
     "reference": [{"tool": "write", "args": {"path": "sales.xlsx", "sheet": "Q1 Targets", "range": "C1:C2", "values": [["Double"], ["=B2*2"]]}},
                   {"tool": "range_ops", "args": {"path": "sales.slim.xlsx", "sheet": "Q1 Targets", "op": "fill", "range": "C2:C3"}}]},
    {"id": "delete-south-orders", "prompt": "Delete every order of the South region from the Orders sheet of sales.xlsx.",
     "tools": ["range_ops", "query"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Orders!C2": "North", "Orders!C3": "North", "Orders!A3": 10002, "Orders!A151": 10298}},
     "reference": [{"tool": "range_ops", "args": {"path": "sales.xlsx", "sheet": "Orders", "op": "delete", "where": "Region = 'South'"}}]},
    {"id": "dashboard-revenue", "prompt": "Build a dashboard sheet from the Orders sheet of sales.xlsx titled 'Sales overview' with one KPI 'Revenue' (sum of Total) and a chart of revenue by Region.",
     "tools": ["build_report", "overview"], "check": {"kind": "written", "file": "sales.slim.xlsx", "cells": {"Dashboard!B1": "Sales overview", "Dashboard!B4": "Revenue", "Dashboard!B5": "=SUM(Orders!$E$2:$E$301)"}},
     "reference": [{"tool": "build_report", "args": {"path": "sales.xlsx", "data_sheet": "Orders", "title": "Sales overview", "kpis": ["Revenue=sum:Total"], "charts": ["compare:Region:Total"]}}]},
    {"id": "what-if-calc", "prompt": "In messy.xlsx, Calc!B1 adds up Calc!A1:A2. If Calc!A1 were 10, what would Calc!B1 be? Do not change the file.",
     "tools": ["what_if", "evaluate"], "check": {"kind": "number", "value": 12},
     "reference": [{"tool": "what_if", "args": {"path": "messy.xlsx", "outputs": ["Calc!B1"], "inputs": ["Calc!A1=10"]}}]},
    {"id": "audit-broken-formula", "prompt": "messy.xlsx has a formula with a misspelled function name. Which cell is it in?",
     "tools": ["anomalies", "evaluate", "find"], "check": {"kind": "text", "value": "C5"},
     "reference": [{"tool": "evaluate", "args": {"path": "messy.xlsx", "cell": "Calc!C5", "check_only": true}}]},
    {"id": "macro-modules", "prompt": "Which VBA modules does macros.xlsm contain?",
     "tools": ["overview", "read"], "check": {"kind": "all", "values": ["ThisWorkbook", "Module1"]},
     "reference": [{"tool": "read", "args": {"path": "macros.xlsm", "sheet": "#vba"}}]},
    {"id": "macro-auto-run", "prompt": "Does any macro in macros.xlsm run by itself when the file opens? Name it and the program it starts.",
     "tools": ["overview", "anomalies", "read"], "check": {"kind": "all", "values": ["Workbook_Open", "notepad"]},
     "reference": [{"tool": "anomalies", "args": {"path": "macros.xlsm", "scope": "macros"}}]},
    {"id": "macro-tidy-value", "prompt": "What text does the Tidy macro in macros.xlsm write, and into which cell? Do not run it.",
     "tools": ["read"], "check": {"kind": "all", "values": ["Done", "D1"]},
     "reference": [{"tool": "read", "args": {"path": "macros.xlsm", "sheet": "#vba", "range": "Module1"}}]},
    {"id": "macro-replace-sort", "prompt": "Do what the SortByAmount macro in macros.xlsm does to the Data sheet, using the tools instead of running the macro.",
     "tools": ["read", "range_ops"], "check": {"kind": "written", "file": "macros.slim.xlsm", "cells": {"Data!A2": "South", "Data!B2": 300, "Data!A3": "West", "Data!A7": "Test"}},
     "reference": [{"tool": "range_ops", "args": {"path": "macros.xlsm", "sheet": "Data", "op": "sort", "range": "A1:B7", "by": "Amount", "desc": true}}]},
    {"id": "macro-replace-delete", "prompt": "Do what the DropTests macro in macros.xlsm does to the Data sheet, without running the macro.",
     "tools": ["read", "range_ops"], "check": {"kind": "written", "file": "macros.slim.xlsm", "cells": {"Data!A2": "North", "Data!A3": "South", "Data!A4": "East", "Data!A5": "West", "Data!A6": null}},
     "reference": [{"tool": "range_ops", "args": {"path": "macros.xlsm", "sheet": "Data", "op": "delete", "where": "Region = 'Test'"}}]},
    {"id": "macro-fill-formula", "prompt": "A colleague wants a VBA macro for macros.xlsm that puts the header 'WithTax' in Data!C1 and =B2*1.1 next to every data row (C2 to C7). Do it with the tools instead of writing a macro.",
     "tools": ["write", "range_ops"], "check": {"kind": "written", "file": "macros.slim.xlsm", "cells": {"Data!C1": "WithTax", "Data!C2": "=B2*1.1", "Data!C7": "=B7*1.1"}},
     "reference": [{"tool": "write", "args": {"path": "macros.xlsm", "sheet": "Data", "range": "C1", "values": [["WithTax"], ["=B2*1.1"]]}},
                   {"tool": "range_ops", "args": {"path": "macros.slim.xlsm", "sheet": "Data", "op": "fill", "range": "C2:C7", "overwrite": true}}]}
  ]
}
